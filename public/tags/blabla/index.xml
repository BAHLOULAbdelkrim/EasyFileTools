    <item>
      <title>Convert Audio</title>
      <link>http://localhost:1313/audio/convert-audio/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>http://localhost:1313/audio/convert-audio/</guid>
      <description>&lt;div class=&#34;auth-bar&#34;&gt;&#xD;&#xA;        &lt;a href=&#34;http://localhost:1313/login&#34; class=&#34;auth-left&#34;&gt;&#xD;&#xA;            &lt;i data-lucide=&#34;log-in&#34;&gt;&lt;/i&gt;&#xD;&#xA;            &lt;span&gt;Login&lt;/span&gt;&#xD;&#xA;        &lt;/a&gt;&#xD;&#xA;&#xD;&#xA;        &lt;a href=&#34;http://localhost:1313/signup&#34; class=&#34;auth-right&#34;&gt;&#xD;&#xA;            &lt;i data-lucide=&#34;user-plus&#34;&gt;&lt;/i&gt;&#xD;&#xA;            &lt;span&gt;Sign Up&lt;/span&gt;&#xD;&#xA;        &lt;/a&gt;&#xD;&#xA;    &lt;/div&gt;&#xD;&#xA;&#xA;&#xD;&#xA;&lt;div&#xD;&#xA;    id=&#34;upload-zone-container&#34;&#xD;&#xA;    data-category=&#34;Audio&#34;&#xD;&#xA;&gt;&#xD;&#xA;&#xD;&#xA;    &lt;div id=&#34;drop-zone&#34;&gt;&#xD;&#xA;&#xD;&#xA;        &lt;div class=&#34;upload-actions&#34;&gt;&#xD;&#xA;&#xD;&#xA;            &lt;label&#xD;&#xA;                for=&#34;fileInput&#34;&#xD;&#xA;                class=&#34;upload-btn&#34;&#xD;&#xA;            &gt;&#xD;&#xA;                &lt;i data-lucide=&#34;folder-open&#34;&gt;&lt;/i&gt;&#xD;&#xA;                Browse&#xD;&#xA;            &lt;/label&gt;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;            &lt;button&#xD;&#xA;                type=&#34;button&#34;&#xD;&#xA;                class=&#34;drag-drop&#34;&#xD;&#xA;                id=&#34;dragBtn&#34;&#xD;&#xA;            &gt;&#xD;&#xA;                &lt;i data-lucide=&#34;upload&#34;&gt;&lt;/i&gt;&#xD;&#xA;                Drag &amp; Drop here&#xD;&#xA;                &lt;i data-lucide=&#34;upload&#34;&gt;&lt;/i&gt;&#xD;&#xA;            &lt;/button&gt;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;            &lt;button&#xD;&#xA;                type=&#34;button&#34;&#xD;&#xA;                class=&#34;upload-btn&#34;&#xD;&#xA;                id=&#34;urlBtn&#34;&#xD;&#xA;            &gt;&#xD;&#xA;                &lt;i data-lucide=&#34;link&#34;&gt;&lt;/i&gt;&#xD;&#xA;                From URL&#xD;&#xA;            &lt;/button&gt;&#xD;&#xA;&#xD;&#xA;        &lt;/div&gt;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;        &lt;input&#xD;&#xA;            type=&#34;file&#34;&#xD;&#xA;            id=&#34;fileInput&#34;&#xD;&#xA;            multiple&#xD;&#xA;        &gt;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;        &lt;div&#xD;&#xA;            id=&#34;urlModal&#34;&#xD;&#xA;            class=&#34;url-modal hidden&#34;&#xD;&#xA;        &gt;&#xD;&#xA;&#xD;&#xA;            &lt;div class=&#34;url-box&#34;&gt;&#xD;&#xA;&#xD;&#xA;                &lt;h3 id=&#34;urlModalTitle&#34;&gt;&#xD;&#xA;                    Paste file URL&#xD;&#xA;                &lt;/h3&gt;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;                &lt;input&#xD;&#xA;                    type=&#34;text&#34;&#xD;&#xA;                    id=&#34;urlInput&#34;&#xD;&#xA;                    placeholder=&#34;https://example.com/file&#34;&#xD;&#xA;                &gt;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;                &lt;div class=&#34;url-actions&#34;&gt;&#xD;&#xA;&#xD;&#xA;                    &lt;button&#xD;&#xA;                        type=&#34;button&#34;&#xD;&#xA;                        id=&#34;urlCancel&#34;&#xD;&#xA;                    &gt;&#xD;&#xA;                        &lt;i data-lucide=&#34;x&#34;&gt;&lt;/i&gt;&#xD;&#xA;                        Cancel&#xD;&#xA;                    &lt;/button&gt;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;                    &lt;button&#xD;&#xA;                        type=&#34;button&#34;&#xD;&#xA;                        id=&#34;urlAdd&#34;&#xD;&#xA;                    &gt;&#xD;&#xA;                        &lt;i data-lucide=&#34;plus&#34;&gt;&lt;/i&gt;&#xD;&#xA;                        Add&#xD;&#xA;                    &lt;/button&gt;&#xD;&#xA;&#xD;&#xA;                &lt;/div&gt;&#xD;&#xA;&#xD;&#xA;            &lt;/div&gt;&#xD;&#xA;&#xD;&#xA;        &lt;/div&gt;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;        &lt;p&#xD;&#xA;            id=&#34;upload-info&#34;&#xD;&#xA;            class=&#34;upload-info&#34;&#xD;&#xA;        &gt;&lt;/p&gt;&#xD;&#xA;&#xD;&#xA;    &lt;/div&gt;&#xD;&#xA;&#xD;&#xA;&lt;/div&gt;&#xA;&#xD;&#xA;&lt;div&#xD;&#xA;    class=&#34;file-list-container&#34;&#xD;&#xA;    data-category=&#34;Audio&#34;&#xD;&#xA;&gt;&#xD;&#xA;&#xD;&#xA;    &lt;div class=&#34;file-counter&#34;&gt;&#xD;&#xA;&#xD;&#xA;        &lt;span id=&#34;fileCounter&#34;&gt;&#xD;&#xA;            0 file&#xD;&#xA;        &lt;/span&gt;&#xD;&#xA;&#xD;&#xA;    &lt;/div&gt;&#xD;&#xA;&#xD;&#xA;    &lt;div id=&#34;file-list&#34;&gt;&lt;/div&gt;&#xD;&#xA;&#xD;&#xA;&lt;/div&gt;&#xA;&#xD;&#xA;&lt;div&#xD;&#xA;    id=&#34;operation-zone&#34;&#xD;&#xA;    class=&#34;operation-zone&#34;&#xD;&#xA;    data-category=&#34;Audio&#34;&#xD;&#xA;&gt;&#xD;&#xA;&#xD;&#xA;    &#xD;&#xA;&#xD;&#xA;    &lt;div class=&#34;operation-top&#34;&gt;&#xD;&#xA;&#xD;&#xA;        &#xD;&#xA;&#xD;&#xA;        &lt;div class=&#34;download-all-wrapper&#34;&gt;&#xD;&#xA;&#xD;&#xA;            &lt;button&#xD;&#xA;                type=&#34;button&#34;&#xD;&#xA;                id=&#34;downloadAllBtn&#34;&#xD;&#xA;                class=&#34;operation-download-all&#34;&#xD;&#xA;                disabled&#xD;&#xA;            &gt;&#xD;&#xA;                &lt;i data-lucide=&#34;download&#34;&gt;&lt;/i&gt;&#xD;&#xA;                Download All&#xD;&#xA;            &lt;/button&gt;&#xD;&#xA;&#xD;&#xA;        &lt;/div&gt;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;        &#xD;&#xA;&#xD;&#xA;        &lt;div class=&#34;clear-all-wrapper&#34;&gt;&#xD;&#xA;&#xD;&#xA;            &lt;button&#xD;&#xA;                type=&#34;button&#34;&#xD;&#xA;                id=&#34;operationClearAllBtn&#34;&#xD;&#xA;                class=&#34;operation-clear-all&#34;&#xD;&#xA;                disabled&#xD;&#xA;            &gt;&#xD;&#xA;                &lt;i data-lucide=&#34;trash-2&#34;&gt;&lt;/i&gt;&#xD;&#xA;                Clear All&#xD;&#xA;            &lt;/button&gt;&#xD;&#xA;&#xD;&#xA;        &lt;/div&gt;&#xD;&#xA;&#xD;&#xA;    &lt;/div&gt;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;    &#xD;&#xA;&#xD;&#xA;    &lt;div&#xD;&#xA;        id=&#34;downloadAllFormats&#34;&#xD;&#xA;        class=&#34;download-all-formats hidden&#34;&#xD;&#xA;    &gt;&#xD;&#xA;    &lt;/div&gt;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;    &lt;div class=&#34;operation-format-selector&#34;&gt;&#xD;&#xA;&#xD;&#xA;        &lt;div&#xD;&#xA;            id=&#34;chooseFormatLabel&#34;&#xD;&#xA;            class=&#34;operation-choose-format&#34;&#xD;&#xA;        &gt;&#xD;&#xA;            Choose Format&#xD;&#xA;        &lt;/div&gt;&#xD;&#xA;&#xD;&#xA;    &lt;/div&gt;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;    &lt;div&#xD;&#xA;        id=&#34;conversionFormats&#34;&#xD;&#xA;        class=&#34;conversion-formats&#34;&#xD;&#xA;    &gt;&#xD;&#xA;    &lt;/div&gt;&#xD;&#xA;&#xD;&#xA;    &#xD;&#xA;&#xD;&#xA;    &lt;div class=&#34;operation-controls&#34;&gt;&#xD;&#xA;&#xD;&#xA;        &lt;button&#xD;&#xA;            type=&#34;button&#34;&#xD;&#xA;            id=&#34;cancelOperationBtn&#34;&#xD;&#xA;            class=&#34;operation-cancel&#34;&#xD;&#xA;            disabled&#xD;&#xA;        &gt;&#xD;&#xA;            &lt;i data-lucide=&#34;x&#34;&gt;&lt;/i&gt;&#xD;&#xA;            Cancel&#xD;&#xA;        &lt;/button&gt;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;        &lt;button&#xD;&#xA;            type=&#34;button&#34;&#xD;&#xA;            id=&#34;convertBtn&#34;&#xD;&#xA;            class=&#34;operation-convert&#34;&#xD;&#xA;            disabled&#xD;&#xA;        &gt;&#xD;&#xA;            &lt;i data-lucide=&#34;refresh-cw&#34;&gt;&lt;/i&gt;&#xD;&#xA;            Convert&#xD;&#xA;        &lt;/button&gt;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;        &lt;button&#xD;&#xA;            type=&#34;button&#34;&#xD;&#xA;            id=&#34;pauseOperationBtn&#34;&#xD;&#xA;            class=&#34;operation-pause&#34;&#xD;&#xA;            disabled&#xD;&#xA;        &gt;&#xD;&#xA;            &lt;i data-lucide=&#34;pause&#34;&gt;&lt;/i&gt;&#xD;&#xA;            Pause&#xD;&#xA;        &lt;/button&gt;&#xD;&#xA;&#xD;&#xA;    &lt;/div&gt;&#xD;&#xA;&#xD;&#xA;    &#xD;&#xA;&#xD;&#xA;    &lt;div class=&#34;operation-progress&#34;&gt;&#xD;&#xA;&#xD;&#xA;        &lt;div class=&#34;progress-block&#34;&gt;&#xD;&#xA;&#xD;&#xA;            &lt;div class=&#34;progress-label&#34;&gt;&#xD;&#xA;&#xD;&#xA;                &lt;span id=&#34;globalProgressLabel&#34;&gt;&#xD;&#xA;                    Conversion progress&#xD;&#xA;                &lt;/span&gt;&#xD;&#xA;&#xD;&#xA;                &lt;span id=&#34;globalProgressPercentage&#34;&gt;&#xD;&#xA;                    0%&#xD;&#xA;                &lt;/span&gt;&#xD;&#xA;&#xD;&#xA;            &lt;/div&gt;&#xD;&#xA;&#xD;&#xA;            &lt;div class=&#34;progress-bar&#34;&gt;&#xD;&#xA;&#xD;&#xA;                &lt;div&#xD;&#xA;                    id=&#34;globalProgress&#34;&#xD;&#xA;                    class=&#34;progress-fill global-progress&#34;&#xD;&#xA;                    style=&#34;width: 0%;&#34;&#xD;&#xA;                &gt;&lt;/div&gt;&#xD;&#xA;&#xD;&#xA;            &lt;/div&gt;&#xD;&#xA;&#xD;&#xA;        &lt;/div&gt;&#xD;&#xA;&#xD;&#xA;    &lt;/div&gt;&#xD;&#xA;&#xD;&#xA;    &#xD;&#xA;&#xD;&#xA;    &lt;div class=&#34;operation-navigation&#34;&gt;&#xD;&#xA;&#xD;&#xA;        &lt;a&#xD;&#xA;            href=&#34;http://localhost:1313/&#34;&#xD;&#xA;            class=&#34;operation-home&#34;&#xD;&#xA;        &gt;&#xD;&#xA;            &lt;i data-lucide=&#34;house&#34;&gt;&lt;/i&gt;&#xD;&#xA;            Go to homepage&#xD;&#xA;        &lt;/a&gt;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;        &lt;button&#xD;&#xA;            type=&#34;button&#34;&#xD;&#xA;            id=&#34;goToTopBtn&#34;&#xD;&#xA;            class=&#34;operation-top-btn&#34;&#xD;&#xA;        &gt;&#xD;&#xA;            &lt;i data-lucide=&#34;arrow-up&#34;&gt;&lt;/i&gt;&#xD;&#xA;            Go to top&#xD;&#xA;        &lt;/button&gt;&#xD;&#xA;&#xD;&#xA;    &lt;/div&gt;&#xD;&#xA;&#xD;&#xA;&lt;/div&gt;</description>
    </item>
